# Copy this file to .env and fill in the values from your CometChat dashboard
# (https://app.cometchat.com -> your app -> API & Auth Keys).
# These two are public identifiers. The secret REST API key goes in the backend repo's .env, never here:
# anything starting with VITE_ is bundled into the browser code.
VITE_COMETCHAT_APP_ID=
VITE_COMETCHAT_REGION=us

# Where the dev server sends /api calls (the server in ../backend). Not bundled into the app.
API_PROXY_TARGET=http://127.0.0.1:4000
