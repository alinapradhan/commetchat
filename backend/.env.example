# Copy to .env. Never commit .env: it holds the CometChat secret key.

# From the CometChat dashboard -> API & Auth Keys. Use a REST API key (fullAccess or authOnly).
# Leave COMETCHAT_REST_API_KEY empty to run in demo mode (works only with the frontend's `npm run demo:auth`).
COMETCHAT_APP_ID=
COMETCHAT_REGION=us
COMETCHAT_REST_API_KEY=

# Server
PORT=4000
HOST=127.0.0.1
# Every web address your frontend is served from, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_DAYS=7

# Production (see README "Deploying"):
# NODE_ENV=production        refuses to start without a real CometChat key; secure cookies on
# SERVE_FRONTEND=true        serve the frontend's built app on the same origin as the API
# FRONTEND_DIR=../frontend/dist            where that build is (this is the default)
# TRUST_PROXY=true           only if behind a reverse proxy that sets X-Forwarded-For
# DB_PATH=/var/lib/commetchat/app.db
